[global]
   server role = standalone server
   security = user
   map to guest = never
   server min protocol = SMB2
   server max protocol = SMB3
   vfs objects = fruit streams_xattr
   fruit:metadata = stream
   fruit:model = MacSamba
   ea support = yes
{% for user in nas_users %}
[{{ user.name }}]
   path = /{{ user.private_dataset }}
   valid users = {{ user.name }}
   read only = no
   browseable = yes
   create mask = 0600
   directory mask = 0700
{% endfor %}
[shared]
   path = /{{ shared_dataset }}
   valid users = @{{ shared_group }}
   force group = {{ shared_group }}
   read only = no
   create mask = 0660
   directory mask = 2770
